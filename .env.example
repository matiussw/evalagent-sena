# =============================================================================
# EvalAgent SENA — plantilla de configuración
#
# Copia este fichero a `.env` y ajusta los valores.
# `.env` NUNCA se versiona: está en .gitignore.
# =============================================================================

# --- Aplicación ---
ENTORNO=desarrollo
DEBUG=false

# --- Base de datos (ADR-002) ---
# En desarrollo con Docker Compose el host es `db`; en local, `localhost`.
DATABASE_URL=postgresql+asyncpg://evalagent:cambia-esta-clave@db:5432/evalagent
POSTGRES_USER=evalagent
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=evalagent

# --- Seguridad (T-003) ---
# Genera una clave nueva con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# El arranque falla si falta, si tiene menos de 32 caracteres o si es un valor
# obvio como "changeme".
SECRET_KEY=
MINUTOS_TOKEN_ACCESO=30
DIAS_TOKEN_REFRESCO=7
BCRYPT_ROUNDS=12

# --- CORS (T-013 · deuda D6) ---
# Lista separada por comas. NO admite `*`: la API envía credenciales y el
# arranque se aborta si se intenta.
CORS_ORIGINS=http://localhost:5173

# --- LLM local (ADR-001) ---
# Ollama corre en el host, no en un contenedor: el acceso a GPU desde contenedor
# exige drivers que un técnico de centro de formación no tiene por qué resolver.
OLLAMA_URL=http://host.docker.internal:11434/api/chat
OLLAMA_MODEL=llama3.1:8b

# --- Reconocimiento de voz ---
# tiny | base | small | medium | large
# Perfil degradado para hardware limitado (riesgo RG-4): WHISPER_MODEL=small
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Síntesis de voz (ADR-005 · corrige la deuda D1) ---
# auto    -> primer motor disponible: piper > say > espeak
# piper   -> fuerza Piper; aborta el arranque si no está instalado
# say     -> comando `say` de macOS (solo desarrollo local)
# espeak  -> espeak-ng en Linux
# ninguno -> modo solo texto, sin audio
TTS_ENGINE=auto
PIPER_BIN=piper
PIPER_VOICE_PATH=/app/voces/es_ES-davefx-medium.onnx
SAY_VOICE=Paulina

# --- Límites ---
MAX_AUDIO_BYTES=10485760
MINUTOS_SESION_INACTIVA=60
